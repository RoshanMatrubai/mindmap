#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = io.github.roshanmatrubai.mindmap
PRODUCT_NAME = mindmap
INFOPLIST_KEY_CFBundleDisplayName = mindmap
// App/Shared/AppIcon.icon, generated by `make icon`.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
// No get-task-allow: nothing may attach a debugger to the real app and read its maps.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO

// The Debug folders hold DEBUG-only code, the dev icon and the bundled fixtures; none of it ships.
EXCLUDED_SOURCE_FILE_NAMES = $(SRCROOT)/App/Shared/Debug/* $(SRCROOT)/App/Mac/Debug/*

#include? "Local.xcconfig"
