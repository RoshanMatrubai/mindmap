{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/Library/Containers/io.github.roshanmatrubai.mindmap/**)",
      "Read(~/Library/Application Scripts/io.github.roshanmatrubai.mindmap/**)",
      "Read(~/Library/Calendars/**)",
      "Read(~/Documents/**)",
      "Read(~/Desktop/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/Mobile Documents/**)",
      "Bash(*Containers/io.github.roshanmatrubai.mindmap)",
      "Bash(*Containers/io.github.roshanmatrubai.mindmap *)",
      "Bash(*Containers/io.github.roshanmatrubai.mindmap/*)",
      "Bash(*Containers/io.github.roshanmatrubai.mindmap\"*)",
      "Bash(*Containers/io.github.roshanmatrubai.mindmap'*)",
      "Bash(*~/Documents*)",
      "Bash(*~/Desktop*)",
      "Bash(*~/Downloads*)",
      "Bash(*HOME/Documents*)",
      "Bash(*HOME/Desktop*)",
      "Bash(*HOME/Downloads*)",
      "Bash(*HOME}/Documents*)",
      "Bash(*HOME}/Desktop*)",
      "Bash(*HOME}/Downloads*)",
      "Bash(*/Users/*/Documents*)",
      "Bash(*/Users/*/Desktop*)",
      "Bash(*/Users/*/Downloads*)",
      "Bash(*Mobile Documents*)"
    ]
  }
}
